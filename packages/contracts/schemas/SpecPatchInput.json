{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "changes": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(components\\.[a-z][a-z0-9-]{0,39}\\.[A-Za-z][A-Za-z0-9]{0,39}|app\\.name|links|entry|posture|security|secrets)$"
          },
          "value": {}
        },
        "required": [
          "path",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "confirm": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(components|app|links|entry|posture|security|check|secrets|unread)(\\.|$)\\S{0,300}$"
      }
    },
    "acceptDraft": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "include": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "required": [
    "baseVersion"
  ],
  "additionalProperties": false
}