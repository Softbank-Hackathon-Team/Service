{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "baseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "changes": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "schemaVersion",
                  "app.name",
                  "service.image",
                  "service.port",
                  "service.healthPath",
                  "service.replicas",
                  "service.cpu",
                  "service.memory",
                  "service.env",
                  "service.secretRefs",
                  "database",
                  "ingress.hostname",
                  "ingress.entry"
                ]
              },
              {
                "type": "string",
                "pattern": "^(components\\.[a-z][a-z0-9-]{0,39}\\.[A-Za-z][A-Za-z0-9]{0,39}|links|entry|posture)$"
              }
            ]
          },
          "value": {}
        },
        "required": [
          "path",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "confirm": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "schemaVersion",
              "app.name",
              "service.image",
              "service.port",
              "service.healthPath",
              "service.replicas",
              "service.cpu",
              "service.memory",
              "service.env",
              "service.secretRefs",
              "database",
              "ingress.hostname",
              "ingress.entry"
            ]
          },
          {
            "type": "string",
            "pattern": "^service\\.env\\.[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          {
            "type": "string",
            "pattern": "^(components|links|entry|check)(\\.|$)\\S{0,300}$"
          }
        ]
      }
    },
    "acceptDraft": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "baseVersion"
  ],
  "additionalProperties": false
}