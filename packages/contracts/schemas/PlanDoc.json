{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "migrationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "adapterVersion": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "provision",
              "deploy",
              "sync",
              "shift",
              "cutover",
              "cleanup"
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "terraform",
              "argocd",
              "agent",
              "worker"
            ]
          },
          "estSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "gate": {
            "type": "string"
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "holdSec": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "rollback": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner"
        ],
        "additionalProperties": false
      }
    },
    "precheck": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "level",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "rollbackCriteria": {
      "type": "object",
      "properties": {
        "errorRatePct": {
          "type": "number"
        },
        "p95Multiplier": {
          "type": "number"
        },
        "windowSec": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "errorRatePct",
        "p95Multiplier",
        "windowSec"
      ],
      "additionalProperties": false
    },
    "tfPlanHash": {
      "type": "string"
    },
    "helmValuesHash": {
      "type": "string"
    },
    "specVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "costSummary": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "monthlyTarget": {
          "type": [
            "number",
            "null"
          ]
        },
        "monthlySource": {
          "type": [
            "number",
            "null"
          ]
        },
        "deltaMonthly": {
          "type": [
            "number",
            "null"
          ]
        },
        "unknownFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priceAsOf": {
          "type": "string"
        },
        "stub": {
          "type": "boolean"
        }
      },
      "required": [
        "currency",
        "monthlyTarget",
        "monthlySource",
        "deltaMonthly",
        "unknownFields"
      ],
      "additionalProperties": false
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "cost",
              "failure_cost_policy",
              "runtime_change",
              "build",
              "precheck_warn",
              "low_confidence"
            ]
          },
          "text": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "irVersion": {
      "type": "string",
      "const": "2"
    },
    "specSource": {
      "type": "string",
      "enum": [
        "spec_v2",
        "upconvert"
      ]
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "postgres",
              "namespace",
              "identity",
              "cache",
              "objectStore",
              "queue",
              "job",
              "service"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "module": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "module"
        ],
        "additionalProperties": false
      }
    },
    "planHash": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    }
  },
  "required": [
    "planId",
    "migrationId",
    "adapterVersion",
    "steps",
    "precheck",
    "rollbackCriteria",
    "tfPlanHash",
    "helmValuesHash",
    "planHash",
    "expiresAt"
  ],
  "additionalProperties": false
}