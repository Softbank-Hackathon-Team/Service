{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "migrationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "adapterVersion": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "provision",
              "deploy",
              "sync",
              "shift",
              "cutover",
              "cleanup"
            ]
          },
          "owner": {
            "type": "string",
            "enum": [
              "terraform",
              "argocd",
              "agent",
              "worker"
            ]
          },
          "estSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "gate": {
            "type": "string"
          },
          "weights": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "holdSec": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "rollback": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "owner"
        ],
        "additionalProperties": false
      }
    },
    "precheck": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "level",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "rollbackCriteria": {
      "type": "object",
      "properties": {
        "errorRatePct": {
          "type": "number"
        },
        "p95Multiplier": {
          "type": "number"
        },
        "windowSec": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "errorRatePct",
        "p95Multiplier",
        "windowSec"
      ],
      "additionalProperties": false
    },
    "tfPlanHash": {
      "type": "string"
    },
    "helmValuesHash": {
      "type": "string"
    },
    "specVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "costSummary": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "monthlyTarget": {
          "type": [
            "number",
            "null"
          ]
        },
        "monthlySource": {
          "type": [
            "number",
            "null"
          ]
        },
        "deltaMonthly": {
          "type": [
            "number",
            "null"
          ]
        },
        "unknownFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priceAsOf": {
          "type": "string"
        },
        "stub": {
          "type": "boolean"
        }
      },
      "required": [
        "currency",
        "monthlyTarget",
        "monthlySource",
        "deltaMonthly",
        "unknownFields"
      ],
      "additionalProperties": false
    },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "cost",
              "failure_cost_policy",
              "runtime_change",
              "build",
              "precheck_warn",
              "low_confidence",
              "tls_relaxed",
              "host_access",
              "public_bucket",
              "provision_reuse",
              "env_layer_create",
              "substitute"
            ]
          },
          "text": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "lost": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "appChange": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "rollbackWindowSec": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "postgres",
              "namespace",
              "identity",
              "cache",
              "objectStore",
              "queue",
              "job",
              "service",
              "vm",
              "netpol"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "module": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "module"
        ],
        "additionalProperties": false
      }
    },
    "targetFacts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 100
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "provision": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "reuse"
        },
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "resources": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "outputsHash": {
          "type": "string"
        }
      },
      "required": [
        "mode",
        "source",
        "resources",
        "outputsHash"
      ],
      "additionalProperties": false
    },
    "envLayer": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "existing",
            "create"
          ]
        },
        "moduleDigest": {
          "type": "string",
          "maxLength": 100
        },
        "varsHash": {
          "type": "string",
          "maxLength": 100
        },
        "notice": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "mode",
        "moduleDigest"
      ],
      "additionalProperties": false
    },
    "planHash": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    }
  },
  "required": [
    "planId",
    "migrationId",
    "adapterVersion",
    "steps",
    "precheck",
    "rollbackCriteria",
    "tfPlanHash",
    "helmValuesHash",
    "planHash",
    "expiresAt"
  ],
  "additionalProperties": false
}