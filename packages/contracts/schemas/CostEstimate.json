{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "priceAsOf": {
      "type": "string"
    },
    "priceStale": {
      "type": "boolean"
    },
    "peakRps": {
      "type": "number"
    },
    "requiredVcpu": {
      "type": "number"
    },
    "load": {
      "type": "object",
      "properties": {
        "baseVcpu": {
          "default": 0.5,
          "type": "number",
          "minimum": 0
        },
        "vcpuPerRps": {
          "default": 0.01,
          "type": "number",
          "minimum": 0
        },
        "utilTarget": {
          "default": 0.6,
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minNodes": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxNodes": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "default": "preset",
          "type": "string",
          "enum": [
            "preset",
            "measured"
          ]
        }
      },
      "required": [
        "baseVcpu",
        "vcpuPerRps",
        "utilTarget",
        "minNodes",
        "maxNodes",
        "source"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "string",
      "enum": [
        "startup",
        "finance"
      ]
    },
    "envs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "aws",
              "gcp",
              "onprem",
              "azure_mock"
            ]
          },
          "feasible": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "nodeSku": {
            "type": [
              "string",
              "null"
            ]
          },
          "nodes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "monthlyUsd": {
            "type": [
              "number",
              "null"
            ]
          },
          "monthlyUsdNoCredit": {
            "type": [
              "number",
              "null"
            ]
          },
          "creditUsd": {
            "type": "number"
          },
          "parts": {
            "type": "object",
            "properties": {
              "cluster": {
                "type": "number"
              },
              "nodes": {
                "type": "number"
              },
              "db": {
                "type": "number"
              },
              "storage": {
                "type": "number"
              },
              "fixed": {
                "type": "number"
              }
            },
            "required": [
              "cluster",
              "nodes",
              "db",
              "storage",
              "fixed"
            ],
            "additionalProperties": false
          },
          "unknown": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unverified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidatesEvaluated": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "provider",
          "feasible",
          "nodeSku",
          "nodes",
          "monthlyUsd",
          "monthlyUsdNoCredit",
          "creditUsd",
          "parts",
          "unknown",
          "unverified",
          "candidatesEvaluated"
        ],
        "additionalProperties": false
      }
    },
    "cheapest": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "aws",
            "gcp",
            "onprem",
            "azure_mock"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "savings": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "aws",
                "gcp",
                "onprem",
                "azure_mock"
              ]
            },
            "to": {
              "type": "string",
              "enum": [
                "aws",
                "gcp",
                "onprem",
                "azure_mock"
              ]
            },
            "monthlyUsd": {
              "type": "number"
            },
            "creditPortionUsd": {
              "type": "number"
            }
          },
          "required": [
            "from",
            "to",
            "monthlyUsd",
            "creditPortionUsd"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "provider": {
            "type": "string",
            "enum": [
              "aws",
              "gcp",
              "onprem",
              "azure_mock"
            ]
          },
          "security": {
            "type": "string",
            "enum": [
              "basic",
              "hardened"
            ]
          },
          "monthlyUsd": {
            "type": "number"
          },
          "score": {
            "type": "number"
          },
          "scoreParts": {
            "type": "object",
            "properties": {
              "cost": {
                "type": "number"
              },
              "risk": {
                "type": "number"
              },
              "time": {
                "type": "number"
              }
            },
            "required": [
              "cost",
              "risk",
              "time"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "rank",
          "provider",
          "security",
          "monthlyUsd",
          "score",
          "scoreParts"
        ],
        "additionalProperties": false
      }
    },
    "breakpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromRps": {
            "type": "number"
          },
          "cheapest": {
            "type": "string",
            "enum": [
              "aws",
              "gcp",
              "onprem",
              "azure_mock"
            ]
          },
          "nodes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "fromRps",
          "cheapest",
          "nodes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "priceAsOf",
    "priceStale",
    "peakRps",
    "requiredVcpu",
    "load",
    "profile",
    "envs",
    "cheapest",
    "savings",
    "recommendations",
    "breakpoints"
  ],
  "additionalProperties": false
}