{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "aws_quick_create",
        "gcp_cloud_shell",
        "onprem_install"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "command": {
      "type": "string"
    },
    "externalId": {
      "type": "string"
    },
    "createBoundaryPolicy": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "expiresAt"
  ],
  "additionalProperties": false
}