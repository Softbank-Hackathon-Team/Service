{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "importing",
        "spec_review",
        "prechecking",
        "planning",
        "awaiting_approval",
        "approved",
        "provisioning",
        "deploying",
        "syncing",
        "shifting",
        "cutover",
        "rollback_window",
        "cleanup",
        "completed",
        "paused",
        "rolling_back",
        "rolled_back",
        "failed",
        "cancelled",
        "rejected",
        "stale"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sourceEnvId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "targetEnvId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "pausedFrom": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "draft",
            "importing",
            "spec_review",
            "prechecking",
            "planning",
            "awaiting_approval",
            "approved",
            "provisioning",
            "deploying",
            "syncing",
            "shifting",
            "cutover",
            "rollback_window",
            "cleanup",
            "completed",
            "paused",
            "rolling_back",
            "rolled_back",
            "failed",
            "cancelled",
            "rejected",
            "stale"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failedAtStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "draft",
            "importing",
            "spec_review",
            "prechecking",
            "planning",
            "awaiting_approval",
            "approved",
            "provisioning",
            "deploying",
            "syncing",
            "shifting",
            "cutover",
            "rollback_window",
            "cleanup",
            "completed",
            "paused",
            "rolling_back",
            "rolled_back",
            "failed",
            "cancelled",
            "rejected",
            "stale"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failureCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollbackWindowEndsAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "status",
    "version",
    "sourceEnvId",
    "targetEnvId",
    "pausedFrom",
    "failedAtStatus",
    "failureCode",
    "rollbackWindowEndsAt",
    "updatedAt"
  ],
  "additionalProperties": false
}