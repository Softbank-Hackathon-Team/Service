{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "precheckBlockers": {
      "type": "number"
    },
    "planHash": {
      "type": "string"
    },
    "staleReason": {
      "type": "string",
      "enum": [
        "expired",
        "env_changed"
      ]
    },
    "applyOk": {
      "type": "boolean"
    },
    "argoHealthy": {
      "type": "boolean"
    },
    "rehearsal": {
      "type": "string",
      "enum": [
        "passed",
        "reused",
        "non_k8s",
        "no_cluster",
        "unsupported_target",
        "disabled",
        "mock"
      ]
    },
    "securityParity": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "not_measured"
        }
      ]
    },
    "replicationLagBytes": {
      "type": "number"
    },
    "rowCountMatch": {
      "type": "boolean"
    },
    "markerRoundTripMs": {
      "type": "number"
    },
    "snapshotDone": {
      "type": "boolean"
    },
    "weightPct": {
      "type": "number"
    },
    "observedSec": {
      "type": "number"
    },
    "targetLogsSeen": {
      "type": "boolean"
    },
    "cutoverStepsOk": {
      "type": "boolean"
    },
    "revertOk": {
      "type": "boolean"
    },
    "cleanupApproved": {
      "type": "boolean"
    },
    "tempResources": {
      "type": "number"
    },
    "operateRoleRevoked": {
      "type": "boolean"
    },
    "guardrailRule": {
      "type": "string"
    },
    "ruleCleared": {
      "type": "boolean"
    },
    "sourceWeight100": {
      "type": "boolean"
    },
    "sourceHealthy": {
      "type": "boolean"
    },
    "manualCleanupConfirmed": {
      "type": "boolean"
    },
    "failureDecision": {
      "type": "string",
      "enum": [
        "retry",
        "rollback"
      ]
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}