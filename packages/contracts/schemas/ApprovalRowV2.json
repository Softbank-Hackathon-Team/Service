{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "runtime_change",
        "build",
        "tls_relaxed",
        "host_access",
        "public_bucket"
      ]
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]{0,38}[a-z0-9])?$"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "subject"
  ],
  "additionalProperties": false
}