{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "redis",
        "valkey",
        "memcached"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_mib": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cluster_mode": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "shards": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "tls": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "auth": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ha": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "allow_from_json": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "engine",
    "version",
    "memory_mib",
    "cluster_mode",
    "shards",
    "tls",
    "auth",
    "ha",
    "allow_from_json"
  ],
  "additionalProperties": false
}