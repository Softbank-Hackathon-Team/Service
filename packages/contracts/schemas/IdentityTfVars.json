{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string"
    },
    "service_account": {
      "type": "string"
    },
    "secret_names_json": {
      "type": "string"
    },
    "grants_json": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "service_account",
    "secret_names_json"
  ],
  "additionalProperties": false
}