{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "aws",
        "gcp",
        "onprem",
        "azure_mock"
      ]
    },
    "name": {
      "type": "string"
    },
    "connectionStatus": {
      "type": "string",
      "enum": [
        "draft",
        "awaiting_customer",
        "verifying",
        "connected",
        "unstable",
        "failed",
        "expired",
        "disconnected"
      ]
    },
    "accountId": {
      "type": [
        "string",
        "null"
      ]
    },
    "targetProjectId": {
      "type": "string"
    },
    "lastVerifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "missingPermissions": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "needsHuman": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "mock": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "id",
    "provider",
    "name",
    "connectionStatus",
    "accountId",
    "lastVerifiedAt",
    "failureReason"
  ],
  "additionalProperties": false
}