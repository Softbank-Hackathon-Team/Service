{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "planHash": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    },
    "acks": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "required": [
    "decision",
    "planHash"
  ],
  "additionalProperties": false
}