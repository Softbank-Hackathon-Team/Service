# 역방향 실험장용 로컬 api·worker 덮어쓰기 (lab.sh platform 이 .env 다음에 읽는다 = 같은 이름은 이 값이 이긴다)
# 클라우드 호출은 전부 흉내(STUB)이고, DB 복제만 진짜다: 출발 = 온프레 PG(실험장), 도착 = 클라우드 PG(실험장)
# 비밀번호는 실험장 전용 고정값 (tools/reverse-lab/init/*.sql). 실환경 값이 아니다
API_PORT=3100
METRICS_PORT=0
WORKER_METRICS_PORT=0
DEV_AUTH=1
MOCK_SEED=1
FAKE_LLM=1
MOCK_PRECHECK=1
MOCK_IAC=1
MOCK_ARGO=1
REAL_STS=0
GITOPS_DISABLE=1
GITOPS_PUSH=0
PLAN_ACKS=0
FAILURE_ANALYSIS=0
VERIFY_CRON=
API_REAPER=
PROM_URL=
TRAFFIC_OBSERVE_SEC=3
# 롤백 장면을 보려면 창이 충분히 길어야 한다 (이 시간 안에 lab.sh e2e rollback 이 시험 행을 넣고 롤백을 누른다)
ROLLBACK_WINDOW_SEC=60
# 복제: 출발 = 온프레 CNPG 자리. 워커는 중계 입구(역방향 터널 끝)로 붙는다. 클라우드 DB 는 중계 안쪽 이름 relay:5432 로 구독한다
REPL_SOURCE_LABEL=onprem-cnpg
REPL_SOURCE_PROVIDER=cnpg
REPL_SOURCE_URL=postgres://svc_migrate:lab-svc-migrate@127.0.0.1:56432/shop
REPL_SOURCE_PEER_URL=postgres://svc_migrate:lab-svc-migrate@relay:5432/shop
REPL_SOURCE_APP_ROLE=shop_app
# 도착 = 클라우드 RDS 자리. 워커는 중계의 플랫폼 입구(:15432)로, 롤백 창에 온프레는 터널의 정방향 입구 tunnel:5432 로 구독한다
REPL_TARGET_LABEL=cloud-rds
REPL_TARGET_PROVIDER=postgres
REPL_TARGET_URL=postgres://app:lab-cloud-admin@127.0.0.1:56433/shop
REPL_TARGET_PEER_URL=postgres://app:lab-cloud-admin@tunnel:5432/shop
REPL_TARGET_APP_ROLE=shop_app
REPL_TABLES=customers,orders
# 구독 접속 문자열에 관리자 대신 길마다 전용 계정 (ADR-027 과 같은 이유)
REPL_EPHEMERAL_USER=1
# 도착(클라우드)에 표 구조를 출발 모양대로 만든다 (실험장 클라우드 DB 는 빈 상태로 시작)
REPL_COPY_SCHEMA=1
REPL_SSLMODE=disable
# 온프레 Agent 보고 서명용 마스터 키 (실험장 전용 가짜 값, 32자 이상). 실험장 Agent 가 이 키로 만든 Agent 키로 하트비트를 보낸다
AGENT_REPORT_MASTER_KEY=reverse-lab-agent-master-key-not-a-real-secret-0001
AGENT_REPORT_URL=http://localhost:3100
