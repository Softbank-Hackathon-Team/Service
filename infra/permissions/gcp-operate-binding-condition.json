{
  "title": "only-platform-named",
  "description": "실행 역할(platform_operate)은 플랫폼 이름 규칙 자원만: app- 접두어(Memorystore·시크릿·버킷·토픽·구독·SA), Cloud SQL 은 <앱>-pg-<해시6>. 만들기·목록(프로젝트 단위 검사)과 GKE(자원 조건 미지원)는 통과",
  "expression": "resource.type == \"cloudresourcemanager.googleapis.com/Project\" || resource.service == \"container.googleapis.com\" || (resource.type == \"sqladmin.googleapis.com/Instance\" && resource.name.extract(\"/instances/{name}\").matches(\"^[a-z0-9]+-pg-[0-9a-f]{6}$\")) || (resource.type == \"redis.googleapis.com/Instance\" && resource.name.extract(\"/instances/{name}\").startsWith(\"app-\")) || (resource.type == \"iam.googleapis.com/ServiceAccount\" && resource.name.extract(\"serviceAccounts/{name}@\").startsWith(\"app-\")) || (resource.type == \"secretmanager.googleapis.com/Secret\" && resource.name.extract(\"/secrets/{name}\").startsWith(\"app-\")) || (resource.type == \"secretmanager.googleapis.com/SecretVersion\" && resource.name.extract(\"/secrets/{name}/\").startsWith(\"app-\")) || (resource.type == \"storage.googleapis.com/Bucket\" && resource.name.startsWith(\"projects/_/buckets/app-\")) || (resource.type == \"pubsub.googleapis.com/Topic\" && resource.name.extract(\"/topics/{name}\").startsWith(\"app-\")) || (resource.type == \"pubsub.googleapis.com/Subscription\" && resource.name.extract(\"/subscriptions/{name}\").startsWith(\"app-\"))"
}
