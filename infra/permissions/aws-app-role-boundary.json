{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnSecretsOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:platform/*",
        "arn:aws:secretsmanager:ap-northeast-2:*:secret:rds!*"
      ]
    },
    {
      "Sid": "MigratedDataGrants",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:ListBucketVersions",
        "s3:ListMultipartUploadParts",
        "s3:PutObject",
        "sqs:ChangeMessageVisibility",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ReceiveMessage",
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:s3:::app-*",
        "arn:aws:s3:::app-*/*",
        "arn:aws:sqs:ap-northeast-2:*:app-*"
      ]
    }
  ]
}
