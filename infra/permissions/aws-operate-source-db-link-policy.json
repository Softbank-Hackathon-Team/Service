{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SourceDbLinkRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:*:*:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "aws:ResourceTag/svc:source-db-link": "open"
        }
      }
    },
    {
      "Sid": "SourceDbLinkMark",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:*:*:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "svc:source-db-link"
          ]
        }
      }
    },
    {
      "Sid": "SourceDbLinkRuleTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags"
      ],
      "Resource": "arn:aws:ec2:*:*:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2",
          "ec2:CreateAction": "AuthorizeSecurityGroupIngress"
        }
      }
    },
    {
      "Sid": "SourceDbLinkRead",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "ec2:DescribeSecurityGroupRules"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    }
  ]
}
