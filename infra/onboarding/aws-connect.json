{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "플랫폼 연결: 관찰 역할(svc-observe)·실행 역할(svc-operate)과 EKS 접근 항목을 만든다 (자동 생성, 직접 고치지 않음)",
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "MinLength": 32,
      "AllowedPattern": "^[A-Za-z0-9_+=,.@:/-]+$",
      "Description": "플랫폼이 알려 준 값 그대로. 역할을 빌릴 때 같이 내야 하는 비밀 아닌 확인값"
    },
    "PlatformPrincipalArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:iam::\\d{12}:(role|user)/.+$",
      "ConstraintDescription": "플랫폼 워커 역할·사용자 ARN(arn:aws:iam::<12자리>:role/... 또는 :user/...)만. :root·assumed-role 은 거부",
      "Description": "역할을 빌릴 수 있는 플랫폼 쪽 역할 하나"
    },
    "EksClusterName": {
      "Type": "String",
      "MinLength": 1,
      "Description": "이전 대상 EKS 클러스터 이름"
    },
    "ArgoHubRoleArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|arn:aws:iam::\\d{12}:role/.+$",
      "ConstraintDescription": "비우거나 Argo CD 허브 역할 ARN(arn:aws:iam::<12자리>:role/...)만",
      "Description": "도착 클러스터에 앱을 배포할 플랫폼 Argo CD 허브 역할 (비우면 배포 역할 없음)"
    },
    "CreateBoundaryPolicy": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "같은 계정에 platform-app-boundary 정책이 이미 있으면 false (이름 충돌 방지)"
    },
    "SourceDbSecurityGroupId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^sg-[0-9a-f]{8,17}$",
      "Description": "온프레 복제를 쓸 때 출발 RDS 보안 그룹 ID. 비우면 중계기의 RDS 나가기·들어오기 규칙 권한을 넣지 않는다"
    },
    "SourceDbInstanceId": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^[a-zA-Z][a-zA-Z0-9-]{0,62}$",
      "Description": "온프레 복제를 쓸 때 출발 RDS DB 식별자. RDS 가 관리하는 그 DB 의 마스터 비밀(Secrets Manager) 하나만 읽게 한다. 비우면 이 권한을 넣지 않는다"
    }
  },
  "Conditions": {
    "HasSourceDbSecurityGroup": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "SourceDbSecurityGroupId"
            },
            ""
          ]
        }
      ]
    },
    "HasSourceDbInstance": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "SourceDbInstanceId"
            },
            ""
          ]
        }
      ]
    },
    "CreateBoundary": {
      "Fn::Equals": [
        {
          "Ref": "CreateBoundaryPolicy"
        },
        "true"
      ]
    },
    "HasArgoHub": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ArgoHubRoleArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "BoundaryPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "CreateBoundary",
      "Properties": {
        "ManagedPolicyName": "platform-app-boundary",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OwnSecretsOnly",
              "Effect": "Allow",
              "Action": [
                "secretsmanager:DescribeSecret",
                "secretsmanager:GetSecretValue"
              ],
              "Resource": [
                "arn:aws:secretsmanager:ap-northeast-2:*:secret:platform/*",
                "arn:aws:secretsmanager:ap-northeast-2:*:secret:rds!*"
              ]
            },
            {
              "Sid": "MigratedDataGrants",
              "Effect": "Allow",
              "Action": [
                "s3:AbortMultipartUpload",
                "s3:DeleteObject",
                "s3:DeleteObjectVersion",
                "s3:GetBucketLocation",
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:ListBucket",
                "s3:ListBucketMultipartUploads",
                "s3:ListBucketVersions",
                "s3:ListMultipartUploadParts",
                "s3:PutObject",
                "sqs:ChangeMessageVisibility",
                "sqs:DeleteMessage",
                "sqs:GetQueueAttributes",
                "sqs:GetQueueUrl",
                "sqs:ReceiveMessage",
                "sqs:SendMessage"
              ],
              "Resource": [
                "arn:aws:s3:::app-*",
                "arn:aws:s3:::app-*/*",
                "arn:aws:sqs:ap-northeast-2:*:app-*"
              ]
            }
          ]
        }
      }
    },
    "OperatePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "svc-operate-policy",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AppRead",
              "Effect": "Allow",
              "Action": [
                "ec2:DescribeSecurityGroupRules",
                "ec2:DescribeSecurityGroups",
                "eks:DescribeCluster",
                "eks:DescribePodIdentityAssociation",
                "rds:DescribeDBInstances",
                "rds:DescribeDBParameterGroups",
                "rds:DescribeDBParameters",
                "rds:DescribeDBSubnetGroups",
                "rds:ListTagsForResource",
                "secretsmanager:DescribeSecret",
                "secretsmanager:GetResourcePolicy"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2"
                }
              }
            },
            {
              "Sid": "AppCreate",
              "Effect": "Allow",
              "Action": [
                "ec2:CreateSecurityGroup",
                "eks:CreatePodIdentityAssociation",
                "rds:CreateDBInstance",
                "rds:CreateDBParameterGroup",
                "rds:CreateDBSubnetGroup",
                "secretsmanager:CreateSecret"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2"
                }
              }
            },
            {
              "Sid": "AppTag",
              "Effect": "Allow",
              "Action": [
                "ec2:CreateTags",
                "rds:AddTagsToResource",
                "secretsmanager:TagResource"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2"
                }
              }
            },
            {
              "Sid": "AppOwned",
              "Effect": "Allow",
              "Action": [
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:DeleteSecurityGroup",
                "ec2:RevokeSecurityGroupEgress",
                "eks:DeletePodIdentityAssociation",
                "rds:DeleteDBInstance",
                "rds:DeleteDBParameterGroup",
                "rds:DeleteDBSubnetGroup",
                "rds:ModifyDBInstance",
                "rds:ModifyDBParameterGroup",
                "secretsmanager:DeleteSecret"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2",
                  "aws:ResourceTag/managed-by": "platform"
                }
              }
            },
            {
              "Sid": "DataDescribe",
              "Effect": "Allow",
              "Action": [
                "elasticache:DescribeCacheClusters",
                "elasticache:DescribeCacheSubnetGroups",
                "elasticache:DescribeReplicationGroups"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2"
                }
              }
            },
            {
              "Sid": "DataScoped",
              "Effect": "Allow",
              "Action": [
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:CreateSecurityGroup",
                "ec2:CreateTags",
                "ec2:DeleteSecurityGroup",
                "ec2:DescribeSecurityGroupRules",
                "ec2:DescribeSecurityGroups",
                "ec2:RevokeSecurityGroupEgress",
                "elasticache:AddTagsToResource",
                "elasticache:CreateCacheSubnetGroup",
                "elasticache:CreateReplicationGroup",
                "elasticache:ListTagsForResource",
                "s3:CreateBucket",
                "s3:DeleteBucket",
                "s3:GetAccelerateConfiguration",
                "s3:GetBucketAcl",
                "s3:GetBucketCORS",
                "s3:GetBucketLocation",
                "s3:GetBucketLogging",
                "s3:GetBucketObjectLockConfiguration",
                "s3:GetBucketPolicy",
                "s3:GetBucketPublicAccessBlock",
                "s3:GetBucketRequestPayment",
                "s3:GetBucketTagging",
                "s3:GetBucketVersioning",
                "s3:GetBucketWebsite",
                "s3:GetEncryptionConfiguration",
                "s3:GetLifecycleConfiguration",
                "s3:GetReplicationConfiguration",
                "s3:ListBucket",
                "s3:PutBucketCORS",
                "s3:PutBucketPublicAccessBlock",
                "s3:PutBucketTagging",
                "s3:PutBucketVersioning",
                "s3:PutEncryptionConfiguration",
                "s3:PutLifecycleConfiguration",
                "sns:CreateTopic",
                "sns:GetTopicAttributes",
                "sns:ListTagsForResource",
                "sns:TagResource",
                "sqs:CreateQueue",
                "sqs:GetQueueAttributes",
                "sqs:GetQueueUrl",
                "sqs:ListQueueTags",
                "sqs:TagQueue"
              ],
              "Resource": [
                "arn:aws:elasticache:*:*:replicationgroup:app-*",
                "arn:aws:elasticache:*:*:cluster:app-*",
                "arn:aws:elasticache:*:*:subnetgroup:app-*",
                "arn:aws:elasticache:*:*:parametergroup:*",
                "arn:aws:s3:::app-*",
                "arn:aws:s3:::app-*/*",
                "arn:aws:sqs:*:*:app-*",
                "arn:aws:sns:*:*:app-*"
              ],
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2"
                }
              }
            },
            {
              "Sid": "DataOwned",
              "Effect": "Allow",
              "Action": [
                "elasticache:DeleteCacheSubnetGroup",
                "elasticache:DeleteReplicationGroup",
                "elasticache:ModifyReplicationGroup",
                "sns:DeleteTopic",
                "sns:SetTopicAttributes",
                "sqs:DeleteQueue",
                "sqs:SetQueueAttributes"
              ],
              "Resource": [
                "arn:aws:elasticache:*:*:replicationgroup:app-*",
                "arn:aws:elasticache:*:*:cluster:app-*",
                "arn:aws:elasticache:*:*:subnetgroup:app-*",
                "arn:aws:elasticache:*:*:parametergroup:*",
                "arn:aws:sqs:*:*:app-*",
                "arn:aws:sns:*:*:app-*"
              ],
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2",
                  "aws:ResourceTag/managed-by": "platform"
                }
              }
            },
            {
              "Sid": "AppDbSecretRead",
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": "arn:aws:secretsmanager:*:*:secret:rds!db-*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2",
                  "aws:ResourceTag/aws:secretsmanager:owningService": "rds"
                },
                "StringLike": {
                  "aws:ResourceTag/aws:rds:primaryDBInstanceArn": "arn:aws:rds:*:*:db:*-pg-??????"
                }
              }
            },
            {
              "Sid": "AppImageRepos",
              "Effect": "Allow",
              "Action": [
                "ecr:BatchCheckLayerAvailability",
                "ecr:BatchGetImage",
                "ecr:CompleteLayerUpload",
                "ecr:CreateRepository",
                "ecr:DescribeRepositories",
                "ecr:InitiateLayerUpload",
                "ecr:ListTagsForResource",
                "ecr:PutImage",
                "ecr:PutImageScanningConfiguration",
                "ecr:PutImageTagMutability",
                "ecr:TagResource",
                "ecr:UploadLayerPart"
              ],
              "Resource": "arn:aws:ecr:*:*:repository/platform/*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2"
                }
              }
            },
            {
              "Sid": "AppImageReposOwned",
              "Effect": "Allow",
              "Action": [
                "ecr:BatchDeleteImage",
                "ecr:DeleteRepository"
              ],
              "Resource": "arn:aws:ecr:*:*:repository/platform/*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2",
                  "aws:ResourceTag/managed-by": "platform"
                }
              }
            },
            {
              "Sid": "AppImageAuth",
              "Effect": "Allow",
              "Action": [
                "ecr:GetAuthorizationToken"
              ],
              "Resource": "*",
              "Condition": {
                "StringEquals": {
                  "aws:RequestedRegion": "ap-northeast-2"
                }
              }
            },
            {
              "Sid": "AppRolesWithBoundary",
              "Effect": "Allow",
              "Action": [
                "iam:CreateRole",
                "iam:PutRolePolicy"
              ],
              "Resource": "arn:aws:iam::*:role/app-*",
              "Condition": {
                "StringEquals": {
                  "iam:PermissionsBoundary": "arn:aws:iam::${aws:PrincipalAccount}:policy/platform-app-boundary"
                }
              }
            },
            {
              "Sid": "AppRolesOnly",
              "Effect": "Allow",
              "Action": [
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:ListInstanceProfilesForRole",
                "iam:ListRolePolicies",
                "iam:TagRole"
              ],
              "Resource": "arn:aws:iam::*:role/app-*"
            },
            {
              "Sid": "AppRolesOwnedDelete",
              "Effect": "Allow",
              "Action": [
                "iam:DeleteRole",
                "iam:DeleteRolePolicy"
              ],
              "Resource": "arn:aws:iam::*:role/app-*",
              "Condition": {
                "StringEquals": {
                  "aws:ResourceTag/managed-by": "platform"
                }
              }
            },
            {
              "Sid": "PassOnlyAppRoles",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": "arn:aws:iam::*:role/app-*",
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "pods.eks.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    },
    "ObserveRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "svc-observe",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AssumeWithExternalId",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "PlatformPrincipalArn"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            },
            {
              "Sid": "SessionTagsAndSourceIdentity",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "PlatformPrincipalArn"
                }
              },
              "Action": [
                "sts:TagSession",
                "sts:SetSourceIdentity"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/job-function/ViewOnlyAccess"
        ],
        "Policies": [
          {
            "PolicyName": "observe-extra",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "guardduty:ListDetectors",
                    "guardduty:GetDetector",
                    "guardduty:ListFindings",
                    "guardduty:GetFindings",
                    "guardduty:GetFindingsStatistics",
                    "eks:DescribeCluster",
                    "eks:ListPodIdentityAssociations",
                    "eks:DescribePodIdentityAssociation",
                    "iam:GetRole",
                    "iam:ListRolePolicies",
                    "iam:GetRolePolicy",
                    "iam:ListAttachedRolePolicies",
                    "iam:GetPolicy",
                    "iam:GetPolicyVersion",
                    "s3:ListAllMyBuckets",
                    "s3:GetBucketVersioning",
                    "s3:GetBucketPublicAccessBlock",
                    "s3:GetBucketPolicyStatus",
                    "s3:GetBucketAcl",
                    "s3:GetLifecycleConfiguration",
                    "s3:GetBucketCORS",
                    "cloudwatch:GetMetricStatistics",
                    "cloudwatch:ListMetrics",
                    "sqs:ListQueues",
                    "sqs:GetQueueAttributes",
                    "elasticache:DescribeReplicationGroups",
                    "elasticache:DescribeCacheClusters",
                    "eks:ListClusters",
                    "rds:DescribeDBInstances",
                    "rds:DescribeDBParameters",
                    "rds:DescribeDBEngineVersions",
                    "ec2:DescribeVpcs",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeRegions",
                    "ec2:DescribeAddresses",
                    "ec2:DescribeNatGateways",
                    "route53:ListHostedZonesByVPC",
                    "route53:ListResourceRecordSets",
                    "ec2:DescribeInstances",
                    "ec2:DescribeInstanceTypes",
                    "ec2:DescribeInstanceStatus",
                    "elasticloadbalancing:DescribeLoadBalancers",
                    "ecs:ListClusters",
                    "ecs:ListServices",
                    "ecs:DescribeServices",
                    "ecs:DescribeTaskDefinition",
                    "ecs:ListTasks",
                    "ecs:DescribeTasks",
                    "elasticloadbalancing:DescribeTargetGroups",
                    "elasticloadbalancing:DescribeListeners",
                    "elasticloadbalancing:DescribeRules",
                    "application-autoscaling:DescribeScalableTargets",
                    "application-autoscaling:DescribeScalingPolicies",
                    "ecr:DescribeRepositories",
                    "secretsmanager:ListSecrets",
                    "servicequotas:GetServiceQuota",
                    "route53:ListHostedZones",
                    "s3:GetBucketNotification",
                    "sns:ListTopics",
                    "sns:ListSubscriptionsByTopic",
                    "ecr:BatchGetImage",
                    "ecr:GetAuthorizationToken",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": "*"
                }
              ]
            }
          },
          {
            "PolicyName": "observe-permcheck",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "iam:SimulatePrincipalPolicy"
                  ],
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:aws:iam::",
                        {
                          "Ref": "AWS::AccountId"
                        },
                        ":role/svc-*"
                      ]
                    ]
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "platform-perms-version",
            "Value": "1"
          }
        ]
      }
    },
    "OperateRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "svc-operate",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AssumeWithExternalId",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "PlatformPrincipalArn"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            },
            {
              "Sid": "SessionTagsAndSourceIdentity",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "PlatformPrincipalArn"
                }
              },
              "Action": [
                "sts:TagSession",
                "sts:SetSourceIdentity"
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "platform-perms-version",
            "Value": "1"
          }
        ],
        "ManagedPolicyArns": [
          {
            "Ref": "OperatePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "source-db-link",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "SourceDbLinkRules",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:AuthorizeSecurityGroupIngress",
                    "ec2:RevokeSecurityGroupIngress"
                  ],
                  "Resource": "arn:aws:ec2:*:*:security-group/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2",
                      "aws:ResourceTag/svc:source-db-link": "open"
                    }
                  }
                },
                {
                  "Sid": "SourceDbLinkMark",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateTags",
                    "ec2:DeleteTags"
                  ],
                  "Resource": "arn:aws:ec2:*:*:security-group/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2"
                    },
                    "ForAllValues:StringEquals": {
                      "aws:TagKeys": [
                        "svc:source-db-link"
                      ]
                    }
                  }
                },
                {
                  "Sid": "SourceDbLinkRuleTags",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateTags"
                  ],
                  "Resource": "arn:aws:ec2:*:*:security-group-rule/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2",
                      "ec2:CreateAction": "AuthorizeSecurityGroupIngress"
                    }
                  }
                },
                {
                  "Sid": "SourceDbLinkRead",
                  "Effect": "Allow",
                  "Action": [
                    "rds:DescribeDBInstances",
                    "ec2:DescribeSecurityGroupRules"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2"
                    }
                  }
                }
              ]
            }
          },
          {
            "PolicyName": "relay",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "RelayDescribe",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeImages",
                    "ec2:DescribeInstances",
                    "ec2:DescribeRouteTables",
                    "ec2:DescribeSecurityGroupRules",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeVpcs",
                    "rds:DescribeDBInstances"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestedRegion": "ap-northeast-2"
                    }
                  }
                },
                {
                  "Sid": "RelayAmiParameter",
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter"
                  ],
                  "Resource": "arn:aws:ssm:ap-northeast-2::parameter/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64"
                },
                {
                  "Sid": "RelayCreateSecurityGroupTagged",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateSecurityGroup"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:security-group/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestTag/managed-by": "platform"
                    },
                    "Null": {
                      "aws:RequestTag/svc:migration": "false"
                    }
                  }
                },
                {
                  "Sid": "RelayCreateSecurityGroupInVpc",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateSecurityGroup"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:vpc/*"
                },
                {
                  "Sid": "RelayRunInstanceTagged",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:RunInstances"
                  ],
                  "Resource": [
                    "arn:aws:ec2:ap-northeast-2:*:instance/*",
                    "arn:aws:ec2:ap-northeast-2:*:network-interface/*",
                    "arn:aws:ec2:ap-northeast-2:*:volume/*"
                  ],
                  "Condition": {
                    "StringEquals": {
                      "aws:RequestTag/managed-by": "platform"
                    },
                    "Null": {
                      "aws:RequestTag/svc:migration": "false"
                    }
                  }
                },
                {
                  "Sid": "RelayRunInSubnet",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:RunInstances"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:subnet/*"
                },
                {
                  "Sid": "RelayRunUsesOwnSg",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:RunInstances"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:security-group/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/managed-by": "platform"
                    },
                    "Null": {
                      "aws:ResourceTag/svc:migration": "false"
                    }
                  }
                },
                {
                  "Sid": "RelayRunAmazonImage",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:RunInstances"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2::image/*",
                  "Condition": {
                    "StringEquals": {
                      "ec2:Owner": "amazon"
                    }
                  }
                },
                {
                  "Sid": "RelayTagOnCreate",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:CreateTags"
                  ],
                  "Resource": [
                    "arn:aws:ec2:ap-northeast-2:*:instance/*",
                    "arn:aws:ec2:ap-northeast-2:*:network-interface/*",
                    "arn:aws:ec2:ap-northeast-2:*:security-group/*",
                    "arn:aws:ec2:ap-northeast-2:*:security-group-rule/*",
                    "arn:aws:ec2:ap-northeast-2:*:volume/*"
                  ],
                  "Condition": {
                    "StringEquals": {
                      "ec2:CreateAction": [
                        "AuthorizeSecurityGroupEgress",
                        "AuthorizeSecurityGroupIngress",
                        "CreateSecurityGroup",
                        "RunInstances"
                      ],
                      "aws:RequestTag/managed-by": "platform"
                    },
                    "Null": {
                      "aws:RequestTag/svc:migration": "false"
                    }
                  }
                },
                {
                  "Sid": "RelayModifyOwnSecurityGroup",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:AuthorizeSecurityGroupEgress",
                    "ec2:AuthorizeSecurityGroupIngress",
                    "ec2:DeleteSecurityGroup",
                    "ec2:RevokeSecurityGroupEgress",
                    "ec2:RevokeSecurityGroupIngress"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:security-group/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/managed-by": "platform"
                    },
                    "Null": {
                      "aws:ResourceTag/svc:migration": "false"
                    }
                  }
                },
                {
                  "Sid": "RelayTerminateOwnInstance",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:TerminateInstances"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:instance/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/managed-by": "platform"
                    },
                    "Null": {
                      "aws:ResourceTag/svc:migration": "false"
                    }
                  }
                },
                {
                  "Sid": "RelaySecurityGroupRuleIds",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:AuthorizeSecurityGroupEgress",
                    "ec2:AuthorizeSecurityGroupIngress",
                    "ec2:RevokeSecurityGroupEgress",
                    "ec2:RevokeSecurityGroupIngress"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:security-group-rule/*"
                },
                {
                  "Sid": "TargetDbRulesForRelay",
                  "Effect": "Allow",
                  "Action": [
                    "ec2:AuthorizeSecurityGroupEgress",
                    "ec2:AuthorizeSecurityGroupIngress",
                    "ec2:RevokeSecurityGroupEgress",
                    "ec2:RevokeSecurityGroupIngress"
                  ],
                  "Resource": "arn:aws:ec2:ap-northeast-2:*:security-group/*",
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/managed-by": "platform"
                    },
                    "Null": {
                      "aws:ResourceTag/tenant": "false"
                    }
                  }
                },
                {
                  "Fn::If": [
                    "HasSourceDbSecurityGroup",
                    {
                      "Sid": "SourceDbEgressToRelay",
                      "Effect": "Allow",
                      "Action": [
                        "ec2:AuthorizeSecurityGroupEgress",
                        "ec2:AuthorizeSecurityGroupIngress",
                        "ec2:RevokeSecurityGroupEgress",
                        "ec2:RevokeSecurityGroupIngress"
                      ],
                      "Resource": {
                        "Fn::Join": [
                          "",
                          [
                            "arn:aws:ec2:ap-northeast-2:",
                            {
                              "Ref": "AWS::AccountId"
                            },
                            ":security-group/",
                            {
                              "Ref": "SourceDbSecurityGroupId"
                            },
                            ""
                          ]
                        ]
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Fn::If": [
                    "HasSourceDbInstance",
                    {
                      "Sid": "SourceDbMasterSecretRead",
                      "Effect": "Allow",
                      "Action": [
                        "secretsmanager:GetSecretValue"
                      ],
                      "Resource": {
                        "Fn::Join": [
                          "",
                          [
                            "arn:aws:secretsmanager:ap-northeast-2:",
                            {
                              "Ref": "AWS::AccountId"
                            },
                            ":secret:rds!db-*"
                          ]
                        ]
                      },
                      "Condition": {
                        "StringEquals": {
                          "aws:ResourceTag/aws:rds:primaryDBInstanceArn": {
                            "Fn::Join": [
                              "",
                              [
                                "arn:aws:rds:ap-northeast-2:",
                                {
                                  "Ref": "AWS::AccountId"
                                },
                                ":db:",
                                {
                                  "Ref": "SourceDbInstanceId"
                                },
                                ""
                              ]
                            ]
                          }
                        }
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "ObserveAccess": {
      "Type": "AWS::EKS::AccessEntry",
      "Properties": {
        "ClusterName": {
          "Ref": "EksClusterName"
        },
        "PrincipalArn": {
          "Fn::GetAtt": [
            "ObserveRole",
            "Arn"
          ]
        },
        "AccessPolicies": [
          {
            "PolicyArn": "arn:aws:eks::aws:cluster-access-policy/AmazonEKSViewPolicy",
            "AccessScope": {
              "Type": "cluster"
            }
          }
        ]
      }
    },
    "OperateAccess": {
      "Type": "AWS::EKS::AccessEntry",
      "Properties": {
        "ClusterName": {
          "Ref": "EksClusterName"
        },
        "PrincipalArn": {
          "Fn::GetAtt": [
            "OperateRole",
            "Arn"
          ]
        },
        "KubernetesGroups": [
          "platform:operate"
        ]
      }
    },
    "DeployRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasArgoHub",
      "Properties": {
        "RoleName": "svc-deploy",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "HubAssume",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "ArgoHubRoleArn"
                }
              },
              "Action": "sts:AssumeRole"
            },
            {
              "Sid": "HubSessionTags",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Ref": "ArgoHubRoleArn"
                }
              },
              "Action": "sts:TagSession"
            }
          ]
        }
      }
    },
    "DeployAccess": {
      "Type": "AWS::EKS::AccessEntry",
      "Condition": "HasArgoHub",
      "Properties": {
        "ClusterName": {
          "Ref": "EksClusterName"
        },
        "PrincipalArn": {
          "Fn::GetAtt": [
            "DeployRole",
            "Arn"
          ]
        },
        "KubernetesGroups": [
          "platform:deploy"
        ]
      }
    }
  },
  "Outputs": {
    "ObserveRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "ObserveRole",
          "Arn"
        ]
      }
    },
    "OperateRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "OperateRole",
          "Arn"
        ]
      }
    },
    "DeployRoleArn": {
      "Condition": "HasArgoHub",
      "Value": {
        "Fn::GetAtt": [
          "DeployRole",
          "Arn"
        ]
      }
    }
  }
}
