# 시험 전용 키 (데모·운영 .env 에 두지 않는다): MOCK_SEED, MOCK_IAC, MOCK_ARGO, MOCK_PRECHECK, FAKE_LLM, DEV_AUTH, IMAGE_BUILD, MOCK_SANDBOX, MOCK_SANDBOX_RESULT
#   DEMO_MODE=1 이면 이 중 하나라도 켜져 있을 때 api·worker·agent-worker 가 뜨지 않고(끝 코드 2), demo:preflight 도 FAIL (z75-68)
# 작업 Z35: 가동 중 앱 숫자. 앱 앞 프록시(tools/load/live-app/switch-proxy.mjs)의 /__stats 전체 주소. 없으면 화면에 "숫자 없음"
# LIVE_TRAFFIC_URL=http://localhost:8090/__stats
# 작업 Z35: 클라우드 DB 쌍 실측 (packages/replication/scripts/measure-cloud.ts). 측정 전용 DB(이름에 measure)만
# MC_SOURCE_URL=postgres://<관리자>:<비번>@<RDS 엔드포인트>:5432/shop_measure?sslmode=require
# MC_SOURCE_PEER_URL=
# MC_SOURCE_PROVIDER=rds
# MC_TARGET_URL=postgres://<관리자>:<비번>@<Cloud SQL IP>:5432/shop_measure?sslmode=require
# MC_TARGET_PROVIDER=cloudsql
# MC_APP_PASSWORD=
# MC_ROWS=10000
# MC_REPS=5
# MC_WORKERS=4
# MC_OUT=
# 앱(api, worker)이 쓰는 DB 계정. 회사 벽(RLS)이 적용되는 계정이다
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/platform
# 표 구조를 바꾸는 계정. 앱은 이 계정을 쓰지 않는다
OWNER_DATABASE_URL=postgres://platform_owner:owner_pw@localhost:5432/platform
API_PORT=3000

# ---- 로그인 (Z93) ----
# 접근 토큰(JWT HS256) 서명 비밀. 32자 이상 무작위 (예: openssl rand -base64 48). 값은 .env 에만.
# 비우면 개발에서는 API 를 띄울 때마다 새로 만든다(다시 띄우면 토큰만 새로 받음). NODE_ENV=production 이면 비어 있을 때 API 가 안 뜬다
# JWT_SECRET=
# 데모 계정 (0018 시드). npm run auth:seed 가 이 비밀번호를 해시로 넣는다. 비우면 무작위로 만들어 .secrets/demo-login.txt 에만 쓴다
# DEMO_USER_EMAIL=demo@dev-company.test
# DEMO_USER_PASSWORD=<8자 이상, 여기엔 쓰지 말고 .env 에만>
# 1 = 개발용 x-dev-tenant 헤더 인증도 받는다. 시험(npm test·test:db·e2e·smoke) 전용. 운영(NODE_ENV=production)에서는 무시
# DEV_AUTH=1
# 토큰 수명(초): 접근 900, 리프레시 28800, 로그인 한 번 최대 86400
# AUTH_ACCESS_TTL_SEC=900
# AUTH_REFRESH_TTL_SEC=28800
# AUTH_SESSION_MAX_SEC=86400
# 1 = 리프레시 쿠키에 늘 Secure (https 뒤에서). 비우면 https 로 들어온 요청에만
# AUTH_COOKIE_SECURE=1
# 로그인 점검: API 앞에 Cloudflare 터널·nginx 가 있으면 실패 제한이 모든 사용자 한 칸이 된다. 앞단이 덮어써 주는 헤더 이름 (예 cf-connecting-ip). 프록시 없이 열려 있으면 켜지 말 것
# AUTH_CLIENT_IP_HEADER=cf-connecting-ip
# 요청 횟수 제한 (Z52). 회사당 분당 읽기 3000·쓰기 120. 부하 측정(tools/load) 때는 RATE_LIMIT=0
# RATE_LIMIT=0
# RATE_LIMIT_READ_PER_MIN=3000
# RATE_LIMIT_WRITE_PER_MIN=120

# DB 복제(CDC) 모듈 @svc/replication. 비워 두면 워커는 가짜(STUB) 복제로 한 바퀴 돈다
# 출발 DB(앱이 지금 쓰는 DB)와 도착 DB. PEER_URL = 도착 DB가 출발 DB에 붙을 때 쓰는 주소(도커면 서비스 이름)
# REPL_SOURCE_URL=postgres://postgres:pw@localhost:55432/shop
# REPL_SOURCE_PEER_URL=postgres://postgres:pw@src:5432/shop
# REPL_SOURCE_PROVIDER=rds        # postgres | rds | cloudsql | cnpg | azure
# REPL_SOURCE_APP_ROLE=shop_app
# REPL_TARGET_URL=postgres://postgres:pw@localhost:55433/shop
# REPL_TARGET_PEER_URL=postgres://postgres:pw@dst:5432/shop
# REPL_TARGET_PROVIDER=cloudsql
# REPL_TARGET_APP_ROLE=shop_app
# 1 = 구독 접속 문자열에 관리자 대신 이전마다 새로 만드는 복제 전용 계정(표 읽기+복제만)을 넣고, 정리 때 지운다 (Z52, Q27)
# REPL_EPHEMERAL_USER=1
# 이전마다 끝점 (db 0050 replication_endpoints, npm run repl:endpoint). 두 줄이 다 있으면 위 REPL_SOURCE/TARGET_* 대신 그 줄을 쓴다
# password_ref derive:<용도> 를 푸는 마스터 키 (32자 이상, 아래는 가짜 값). env:REPL_SECRET_<이름> 참조는 그 이름의 변수를 읽는다
# REPL_SECRET_MASTER_KEY=change-me-change-me-change-me-0000
# 출발 AWS → 온프레 이전: apply 가 출발 계정에 SSH 중계기를 만들고 정리 때 지운다 (worker relay/). 시드 환경·REAL_STS=0 이면 안 만든다
#   PLATFORM_EGRESS_CIDRS = 플랫폼 워커가 밖으로 나가는 IP 대역 (쉼표 목록, /24 보다 좁게). 중계 5432 를 이 대역에만 연다. 이 길에서는 필수
# PLATFORM_EGRESS_CIDRS=203.0.113.10/32
#   0 = 워커가 중계기를 안 만든다 (운영자가 tools/onprem-relay.sh 로 직접)
# RELAY_AUTO=0
# 도착 끝점이 줄에서 왔을 때 sync 가 붙기 전에 TCP 로 확인하는 시간 (ms)
# REPL_REACH_TIMEOUT_MS=5000

# ---- 관측 (T). 0 이면 지표 서버를 안 연다 ----
METRICS_PORT=9464
WORKER_METRICS_PORT=9465
# 워커를 여러 개 띄울 때는 워커마다 WORKER_METRICS_PORT 를 다르게(예: 9466) 하거나 0(지표 끔). 2차부터는 차 있으면 다음 포트로 자동으로 넘어간다(Z36)
LOG_LEVEL=info

# ---- 클라우드 계정 (값은 .env 에만. 여기엔 이름만) ----
# AWS: ~/.aws 의 프로필 이름. GCP: gcloud ADC(application-default login), 프로젝트 finals-demo
AWS_PROFILE=finals
# GCP_PROJECT=finals-demo
# 가격 API (V). 없으면 packages/cost/prices 캐시를 그대로 쓴다
# GCP_BILLING_API_KEY=

# ---- AI 에이전트 (명세 초안·장애 점검). 작업 Z90: 기본 = 실제 Claude API ----
# 키가 없으면 실행이 LLM_KEY_MISSING 으로 실패하고 화면에 "AI 키 없음" 이 뜬다 (가짜 결과를 만들지 않는다)
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5   # claude-opus-5-5 로 바꿀 수 있다
# AGENT_LLM_EFFORT=medium         # low | medium | high | xhigh | max
# AGENT_LLM_TIMEOUT_MS=120000     # 호출 한 번 시간 제한
# AGENT_LLM_MAX_RETRIES=2         # 429·5xx·연결 오류 재시도 횟수
# AGENT_LLM_CACHE=1               # z75-59: 실제 API 응답 캐시 (회사별, 같은 요청이면 다시 안 부름). 0 이면 끔
# AGENT_LLM_CACHE_TTL_SEC=86400   # 캐시 기한 (60~604800). 데모 초기화는 캐시를 안 지운다
# LLM_BUDGET_USD=2                # z75-64: 회사·회차마다 실제 LLM 지출 상한 (달러 추정). 넘으면 새 AI 점검 409·실패 LLM_BUDGET_EXCEEDED. 캐시 응답은 0원
# LLM_BUDGET_GLOBAL_USD=10        # 회차 하나의 모든 회사 합 상한 (API 키가 하나라서). 넘으면 모든 회사가 막힘
# LLM_BUDGET_ROUND=               # 회차 이름 (비우면 오늘 날짜 UTC). 새 회차를 열려면 이름을 바꾼다. 데모 초기화는 지출을 안 지운다
# FAKE_LLM=1                      # 시험 전용 가짜 LLM. 데모·운영에서는 쓰지 않는다 (사전점검이 실패로 본다)
# SANDBOX_MODE=memory             # memory | k3d (맥: k3d cluster agent-sbx + kubectl proxy) | vcluster (플랫폼 EKS)
# SANDBOX_KUBE_URL=http://127.0.0.1:8001   # 샌드박스 클러스터. vcluster·리허설은 비면 클러스터 안 서비스 계정 (토큰은 요청마다 다시 읽음).
#                                          #   값이 있으면 플랫폼 클러스터 밖 실행: 가상 API 는 kubectl port-forward (sbx-operator 의 pods/portforward)
# SANDBOX_KUBE_TOKEN_FILE=        # (선택) SANDBOX_KUBE_URL 과 함께 쓰는 토큰 파일
# SANDBOX_KUBE_CA_FILE=           # (선택) 같은 서버의 CA 파일
# SANDBOX_HELM_BIN=               # vCluster 차트를 올리는 helm (기본 PATH 의 helm, 이미지는 /usr/local/bin/helm)
# SANDBOX_KUBECTL_BIN=            # 클러스터 밖에서 port-forward 를 여는 kubectl (기본 PATH 의 kubectl, 이미지는 /usr/local/bin/kubectl)
# SANDBOX_NODE_PREFIX=k3d-agent-sbx-

# ---- vCluster 리허설 (deploying 안, GitOps 커밋 바로 앞). 기본 꺼짐 ----
# 워커
# SANDBOX_REHEARSAL=off           # off | on. 꺼지면 skipped(disabled) 줄만 남기고 커밋
# REHEARSAL_TIMEOUT_SEC=1200      # 실행 기한: agent-worker 가 줄을 잡은 때부터 결과까지 (넘으면 REHEARSAL_TIMEOUT 으로 paused, 300 이상)
# REHEARSAL_QUEUE_TIMEOUT_SEC=3600   # 줄 서기 기한: 줄을 만든 때부터 agent-worker 가 잡을 때까지 (리허설은 한 번에 1건)
# REHEARSAL_POLL_SEC=60           # 깨우기가 안 왔을 때 다시 보는 간격
# SANDBOX_IMAGE_REGISTRY=         # 플랫폼 ECR 샌드박스 자리 <호스트>/<접두어>. on 이면 꼭 필요 (MOCK_SANDBOX=1 이면 없어도 됨)
# agent-worker (SANDBOX_MODE=vcluster)
# SANDBOX_RUNTIME_CLASS=          # gVisor 스위치. 리허설·수정 고리 둘 다. 비면 노드 기본 런타임 (gVisor 없는 로컬 kind)
# SANDBOX_TTL_SEC=1800            # 호스트 sbx 네임스페이스 만료 (청소 기준)
# SANDBOX_VCLUSTER_CHART=/app/vendor/vcluster-0.37.6.tgz   # 로컬은 apps/agent-worker/vendor/vcluster-0.37.6.tgz (CRD 는 옆 crds/)
# 시험 전용 (DEMO_MODE=1 이면 서비스가 안 뜬다): 클러스터 없이 정해진 결과. 워커·agent-worker 둘 다 켠다
# MOCK_SANDBOX=1
# MOCK_SANDBOX_RESULT=fail        # pass(기본) | fail

# ---- GitOps 배포 (N2). 둘 다 비우면 deploy 는 STUB ----
# GITOPS_REPO_URL=https://github.com/<org>/<gitops-repo>.git
# GITOPS_WRITE_TOKEN=
# GITOPS_READ_TOKEN=
# GITOPS_REPO_DIR=
# GITOPS_BRANCH=main
# push 는 기본 꺼짐. 1 일 때만 원격에 올린다
# GITOPS_PUSH=1
# 설정이 있어도 deploy 를 STUB 으로 (test:db 는 자동으로 켬)
# GITOPS_DISABLE=1

# ---- 트래픽 전환 (J). PROM_URL·TRAFFIC_PROVIDER(또는 cf:check --register 로 이전별 LB)가 없으면 shift 가 TRAFFIC_NOT_CONFIGURED 로 멈춘다.
#      흉내 지표·mock 전환기는 MOCK_IAC=1 또는 MOCK_TRAFFIC=1 (시험 전용)일 때만. TRAFFIC_STUB_SCENARIO 는 그때 고르는 시나리오 ----
# CLOUDFLARE_API_TOKEN=
# 워커 전용 (FM-TRF-18): Zone · Load Balancers: Edit 만 준 토큰. 있으면 워커는 이것만 쓴다 (cf-check 는 위 토큰)
# #245 진짜 지표로 몫을 볼 때(PROM_URL)는 출발 ALB 를 찾느라 Zone: Read, Account · Load Balancing: Monitors and Pools: Read 가 더 필요하다
# CLOUDFLARE_WORKER_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=softbank-team-iron.com
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_SOURCE_POOL_ID=
# CLOUDFLARE_TARGET_POOL_ID=
# TRAFFIC_PROVIDER=
# TRAFFIC_LB_ID=
# TRAFFIC_STUB_SCENARIO=ok
# 단계마다 최소로 관찰할 초 (z75-38: 10%·50%·100% 모두. 100% 는 T22). 운영 기본 30. 로컬 개발·smoke·데모는 짧게 (감사에 observeCompressed 가 남는다)
# 다음 단계로 가려면 이 시간이 지나고 + 실측 도착 몫(지표 창 요청 수)이 목표 ±10%p 안이어야 한다. 못 미치면 같은 길이로 2번 더 보고, 그래도면 paused (TRAFFIC_SHARE_NOT_REACHED)
# TRAFFIC_SHARE_CHECK=0 이면 이 확인을 끈다 (예전 동작: 10%·50% 는 판정 3번, 표본이 없는 실클라우드 리허설 등). 기본 켬
# TRAFFIC_SHARE_CHECK=1
TRAFFIC_OBSERVE_SEC=0.5
# PERMISSIONS_DIR=infra/permissions
# TEMP_ROLE_SWEEP_MS=15000

# ---- 도착 자원 (Z89): 기본 = 진짜 terraform (aws/gcp/onprem). 흉내는 시험 전용 ----
# MOCK_IAC=1 이면 apply 를 흉내(가짜 출력). test:db·e2e·prod-e2e 만 붙인다. .env 에는 넣지 않는다
# MOCK_ARGO=1 이면 GitOps 설정 없을 때 deploy 흉내 (없으면 paused GITOPS_NOT_CONFIGURED)
# 작업 폴더 = TF_WORK_DIR/<회사 slug>/<이전 id> (state 회사별). 예전 USE_TERRAFORM·TF_REAL_APPLY 는 무시
# TF_WORK_DIR=~/.svc-tf
# TF_BIN=terraform
# TF_APPLY_TIMEOUT_SEC=2700
# TF_LOCK_TIMEOUT_SEC=60
# TF_DESTROY_ON_FAIL=0   # 1 이면 apply 실패 즉시 destroy (기본 0: 실패 질문 뒤 거절→롤백 때 지움)

# ---- Azure 는 Mock 만 (X) ----
AZURE_MOCK=1
# AZURE_MOCK_LATENCY_MS=300
# AZURE_MOCK_FAIL=

# ---- 시험·데모용 실패 흉내 (평소엔 비움) ----
# APPLY_STUB_FAIL=1
# SYNC_STUB_FAIL=1
# REPL_TABLES=customers,orders

# 롤백 가능 창(초). 데모·e2e 롤백 장면에서 버튼 누를 시간. 비우면 3초
# ROLLBACK_WINDOW_SEC=20

# 환경 잠금 기한(초)과 DB에 못 닿을 때 스스로 멈추는 시간(초). 비우면 90·60.
# 워커가 죽었을 때 회복을 빨리 보려면 45·30. 워커·API 모두 같은 값이어야 한다.
# 연장 간격 < 스스로 멈춤 < 기한 이 아니면 시작할 때 멈춘다. 연장 간격은 비우면 기한의 1/3
# ENVLOCK_WORKER_SEC=45
# ENVLOCK_SELF_FENCE_SEC=30
# ENVLOCK_HEARTBEAT_SEC=15

# --- Z92: 온프레 Agent 보고 (POST /api/v1/agent/reports) ---
# 서버(API): Agent 키 비밀을 만드는 마스터 값. 32자 이상. 비우면 보고 경로가 503 AGENT_REPORTS_DISABLED
#   만들기 예: openssl rand -hex 32   (값은 .env 에만, 채팅·공유 폴더 금지)
# AGENT_REPORT_MASTER_KEY=
# heartbeat 가 이 초보다 오래되면 화면에 stale (기본 120)
# AGENT_STALE_SEC=120
# W5(워커): 보안 판정(SEC_PRECHECK=1)이 온프레 도착 DB 사실로 쓰는 Agent facts 보고의 최대 나이(초). 더 오래되면 모름 (기본 900)
# AGENT_FACTS_MAX_AGE_SEC=900
# W4(워커): 온프레 배포를 Agent 의 deploy 보고(클러스터 안 Argo 상태)로 확인. 기본 켬. Agent 가 없는 온프레(로컬 k3d 시연 등)는 0 (예전처럼 커밋만 하고 applied)
# AGENT_DEPLOY_CONFIRM=0
# AGENT_DEPLOY_WAIT_SEC=600
# W3(워커): 온프레 바닥(네임스페이스·할당량)을 Terraform(kube_context 로 들어감) 대신 gitops 묶음 + 고객 Argo CD 로. 기본 켬
#   gitops 레포 charts/app 에 templates/floor.yaml 이 있어야 할당량이 그려진다 (이 레포 gitops/charts/app 사본과 같게). 고객 Argo CD 가 없는 온프레는 0
# ONPREM_FLOOR_VIA_GIT=0
# Agent(온프레 쪽, tools/onprem-agent.ts): npm run agent:key 가 .agent-key.env 파일로 써 준다
# AGENT_REPORT_URL=http://localhost:3000
# AGENT_KEY_ID=
# AGENT_KEY_SECRET=
# AGENT_NAMESPACE=app
# AGENT_CNPG_CLUSTER=app-db
# AGENT_KUBE_CONTEXT=k3d-onprem

# --- Z94 Argo CD 반영 확인 (deploy → syncing). 하나도 없으면 클라우드 배포는 ARGO_NOT_CONFIGURED 로 paused ---
# REST 길: 읽기 전용 계정 토큰
# ARGOCD_URL=https://argocd.example.com
# ARGOCD_TOKEN=
# k8s 길: 허브 클러스터 kube 컨텍스트로 Application CR 읽기 (ARGOCD_URL 없을 때)
# ARGO_KUBE_CONTEXT=
# ARGOCD_NAMESPACE=argocd
# ARGO_SOURCE=auto
# ARGO_WAIT_SEC=180
# ARGO_TICK_MS=2000
# ARGO_MAX_ERRORS=10
# ARGO_REQ_TIMEOUT_MS=5000
# MOCK_ARGO=1 은 시험 전용 (바로 ok)

# ── 사전 점검 실조회 (Z97) ── 읽기 명령만(aws sts/ec2/rds/service-quotas, gcloud auth/services/billing/compute/sql, kubectl auth/get)
# MOCK_PRECHECK=1 은 시험 전용(test:db·e2e 가 켬). 데모·리허설에서는 켜지 않는다
# MOCK_PRECHECK=
# PRECHECK_TIMEOUT_MS=10000
# PRECHECK_TCP_TIMEOUT_MS=3000
# GCP_REGION=asia-northeast3
# DB_STORAGE_GB=20
# CLOUDSQL_PG_MAJORS=9.6,10,11,12,13,14,15,16,17

# 신뢰도 문턱값 (0 = 꺼짐, 0~1). 켜면 이 값 미만이고 사람이 승인 안 한 명세 칸이 있을 때 spec_review → prechecking 이 막힌다
SPEC_MIN_CONFIDENCE=0
# API 프로세스에도 청소 담당(lease-reaper) 한 벌. 1이면 켬 (기본 off, 개발 실행용)
API_REAPER=0
# L4: 진짜 발급기(AWS sts assume-role CLI, GCP gcloud impersonate)가 기본. 비우거나 1 = 진짜 (external_id 없는·고객 SA 모양 아닌 시드 환경만 mock)
# 0 = 전부 흉내 발급기. 로컬 개발·시험은 0 으로 명시해서 끈다
REAL_STS=0

# ---- 고객 환경 연결 (입력층 L2). 둘 다 비우면 AWS 연결 링크 발급이 503 CONNECT_NOT_CONFIGURED ----
# CloudFormation 템플릿 S3 https 주소 (infra/onboarding 템플릿을 올린 곳). 가짜 값 넣지 말 것 (진짜 경로로 오해)
CONNECT_TEMPLATE_URL=
# 고객 역할을 빌릴 플랫폼 워커 역할 ARN (arn:aws:iam::<12자리>:role/<이름>). 값은 .env 에만
PLATFORM_PRINCIPAL_ARN=
# 플랫폼 Argo CD 허브 역할 ARN (infra/modules/aws/platform 출력 argocd_hub_role_arn, api·worker 둘 다).
#   있으면 api 연결 링크가 고객 템플릿에 svc-deploy 를 만들고, worker 가 EKS 도착에 RoleBinding·Argo cluster Secret 을 만든다. 비우면 예전처럼 사람이 등록
ARGO_HUB_ROLE_ARN=

# 이미지 빌드(명세 v2의 image.source=build 서비스). 1이면 apply 앞에서 부른다. 기본 off
#   시험 전용: 진짜 빌더가 없어 1 이면 입력으로 만든 고정 digest (STUB). DEMO_MODE=1 이면 서비스가 안 뜬다
# IMAGE_BUILD=0
# L4b: 연결 주기 재확인 일정 (cron 5칸). 비우면 1시간마다 정각. 데모는 "* * * * *", 끄기는 off
VERIFY_CRON=

# 계획 승인 확인 항목 게이트 (PA4). 켜지면 승인 때 acks 가 계획서 확인 항목을 전부 덮어야 하고, /start 본문 planHash 가 승인 지문과 같아야 함.
# G7-8: 기본 켬 (화면·smoke 가 늘 acks·planHash 를 보냄). 0 이면 끔 (옛 스크립트·시험용)
# PLAN_ACKS=0
# 회사당 동시 진행 이전 상한. 넘으면 start 가 409 TENANT_BUSY. 비우거나 0 = 꺼짐
# TENANT_MAX_ACTIVE=0
# L7i: 진짜 발급기(REAL_STS 0 아님)일 때 GCP 진짜 발급(gcloud impersonate)에 쓰는 플랫폼 프로젝트 ID. 진짜 켜짐 + 비우면 GCP 고객 SA 발급은 PLATFORM_SA_MISSING 실패
#   FM-GCP-11: 워커 .env 에 꼭 넣을 것. 비어 있으면 tools/gcp-account-check.sh(up-preflight)가 FAIL gcp-platform-project 로 실행 전에 막음 (GCP 를 안 쓰는 판이면 GCP_ACCOUNT_CHECK_GCP_OFF=1)
GCP_PLATFORM_PROJECT=
# FM-ENV-03: gcloud 활성 계정·ADC 가 이 계정이어야 함 (tools/gcp-account-check.sh·up-preflight 가 대조, 다르면 FAIL). 비우면 WARN 만
GCP_EXPECTED_ACCOUNT=
# FM-GCP-03: 사용자가 누른 GCP 연결 확인이 IAM 전파를 기다리며 다시 보는 간격·횟수 (기본 20000ms × 4)
# GCP_VERIFY_RETRY_MS=20000
# GCP_VERIFY_ATTEMPTS=4

# ---- 온프레 등록 (입력층 L6) ----
# Agent 설치 한 줄에 넣을 API 주소 (고객 k3s 에서 닿는 주소). 비우면 요청이 들어온 주소
# PUBLIC_API_URL=

# 가져오기가 AWS 앱 신원(Pod Identity·IRSA)의 IAM 정책도 읽어 의존성 grants·보안 기준선을 채움 (I4). 1 = 켬, 기본 꺼짐
# IMPORT_AWS_IAM=0
# 보안 판정 연결: 사전 점검에 보안 판정(SEC:*)을 붙인다 (고객 요구사항 + 출발·도착 보안 사실). 기본 꺼짐, 1 = 켬 (보안 시연 환경에서만)
# SEC_PRECHECK=1

# GitHub 로그인 (GHLOGIN). 이메일+비밀번호 로그인은 그대로 둔다. CLIENT_ID 와 CLIENT_SECRET 둘 다 있어야 켜진다 (아래는 가짜 값)
# GitHub OAuth App 의 Authorization callback URL = <공개 주소>/api/v1/auth/github/callback
# GITHUB_CLIENT_ID=fake-github-client-id
# GITHUB_CLIENT_SECRET=fake-github-client-secret
# 비우면 PUBLIC_API_URL + /api/v1/auth/github/callback
# GITHUB_REDIRECT_URI=
# 로그인 뒤 화면 경로 ("/" 로 시작하는 경로만, 아니면 "/")
# GITHUB_POST_LOGIN_URL=/
# 모르는 이메일의 GitHub 가입 허용: 둘 다 있어야 한다 (없으면 미리 만든 사용자만 로그인)
# GITHUB_SIGNUP_TENANT_ID=00000000-0000-0000-0000-000000000000
# GITHUB_SIGNUP_EMAIL_DOMAINS=example.com

# 팀 가입 명부 (POST /api/v1/auth/signup, 초대 코드 + 미리 만드는 환경). 이미지 기본은 /app/team-env/registry.yaml
#   로컬은 레포의 명부를 가리킨다. 없거나 틀리면 가입만 꺼진다 (api 경고 한 줄)
# TEAM_REGISTRY_PATH=docs/team-env/registry.yaml
