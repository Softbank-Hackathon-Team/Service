# 시험 전용 키 (데모·운영 .env 에 두지 않는다): MOCK_SEED, MOCK_IAC, MOCK_ARGO, MOCK_PRECHECK, FAKE_LLM, DEV_AUTH, MOCK_CREDS, MOCK_REPL, MOCK_TRAFFIC
#   DEMO_MODE=1 이면 이 중 하나라도 켜져 있을 때 api·worker·agent-worker 가 뜨지 않고(끝 코드 2), demo:preflight 도 FAIL (z75-68)
# 작업 Z35: 가동 중 앱 숫자. 앱 앞 프록시(tools/load/live-app/switch-proxy.mjs)의 /__stats 전체 주소. 없으면 화면에 "숫자 없음"
# LIVE_TRAFFIC_URL=http://localhost:8090/__stats
# 작업 Z35: 클라우드 DB 쌍 실측 (packages/replication/scripts/measure-cloud.ts). 측정 전용 DB(이름에 measure)만
# MC_SOURCE_URL=postgres://<관리자>:<비번>@<RDS 엔드포인트>:5432/shop_measure?sslmode=require
# MC_SOURCE_PEER_URL=
# MC_SOURCE_PROVIDER=rds
# MC_TARGET_URL=postgres://<관리자>:<비번>@<Cloud SQL IP>:5432/shop_measure?sslmode=require
# MC_TARGET_PROVIDER=cloudsql
# MC_APP_PASSWORD=
# MC_ROWS=10000
# MC_REPS=5
# MC_WORKERS=4
# MC_OUT=
# 앱(api, worker)이 쓰는 DB 계정. 회사 벽(RLS)이 적용되는 계정이다
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/platform
# 표 구조를 바꾸는 계정. 앱은 이 계정을 쓰지 않는다
OWNER_DATABASE_URL=postgres://platform_owner:owner_pw@localhost:5432/platform
API_PORT=3000

# ---- 로그인 (Z93) ----
# 접근 토큰(JWT HS256) 서명 비밀. 32자 이상 무작위 (예: openssl rand -base64 48). 값은 .env 에만.
# 비우면 개발에서는 API 를 띄울 때마다 새로 만든다(다시 띄우면 토큰만 새로 받음). NODE_ENV=production 이면 비어 있을 때 API 가 안 뜬다
# JWT_SECRET=
# 데모 계정 (0018 시드). npm run auth:seed 가 이 비밀번호를 해시로 넣는다. 비우면 무작위로 만들어 .secrets/demo-login.txt 에만 쓴다
# DEMO_USER_EMAIL=demo@dev-company.test
# DEMO_USER_PASSWORD=<8자 이상, 여기엔 쓰지 말고 .env 에만>
# 1 = 개발용 x-dev-tenant 헤더 인증도 받는다. 시험(npm test·test:db·e2e·smoke) 전용. 운영(NODE_ENV=production)에서는 무시
# DEV_AUTH=1
# 토큰 수명(초): 접근 900, 리프레시 28800, 로그인 한 번 최대 86400
# AUTH_ACCESS_TTL_SEC=900
# AUTH_REFRESH_TTL_SEC=28800
# AUTH_SESSION_MAX_SEC=86400
# 1 = 리프레시 쿠키에 늘 Secure (https 뒤에서). 비우면 https 로 들어온 요청에만
# AUTH_COOKIE_SECURE=1
# 요청 횟수 제한 (Z52). 회사당 분당 읽기 3000·쓰기 120. 부하 측정(tools/load) 때는 RATE_LIMIT=0
# RATE_LIMIT=0
# RATE_LIMIT_READ_PER_MIN=3000
# RATE_LIMIT_WRITE_PER_MIN=120

# DB 복제(CDC) 모듈 @svc/replication. 비워 두면 워커는 가짜(STUB) 복제로 한 바퀴 돈다
# 출발 DB(앱이 지금 쓰는 DB)와 도착 DB. PEER_URL = 도착 DB가 출발 DB에 붙을 때 쓰는 주소(도커면 서비스 이름)
# REPL_SOURCE_URL=postgres://postgres:pw@localhost:55432/shop
# REPL_SOURCE_PEER_URL=postgres://postgres:pw@src:5432/shop
# REPL_SOURCE_PROVIDER=rds        # postgres | rds | cloudsql | cnpg | azure
# REPL_SOURCE_APP_ROLE=shop_app
# REPL_TARGET_URL=postgres://postgres:pw@localhost:55433/shop
# REPL_TARGET_PEER_URL=postgres://postgres:pw@dst:5432/shop
# REPL_TARGET_PROVIDER=cloudsql
# REPL_TARGET_APP_ROLE=shop_app
# 1 = 구독 접속 문자열에 관리자 대신 이전마다 새로 만드는 복제 전용 계정(표 읽기+복제만)을 넣고, 정리 때 지운다 (Z52, Q27)
# REPL_EPHEMERAL_USER=1

# ---- 관측 (T). 0 이면 지표 서버를 안 연다 ----
METRICS_PORT=9464
WORKER_METRICS_PORT=9465
# 워커를 여러 개 띄울 때는 워커마다 WORKER_METRICS_PORT 를 다르게(예: 9466) 하거나 0(지표 끔). 2차부터는 차 있으면 다음 포트로 자동으로 넘어간다(Z36)
LOG_LEVEL=info

# ---- 클라우드 계정 (값은 .env 에만. 여기엔 이름만) ----
# AWS: ~/.aws 의 프로필 이름. GCP: gcloud ADC(application-default login), 프로젝트 finals-demo
AWS_PROFILE=finals
# GCP_PROJECT=finals-demo
# 가격 API (V). 없으면 packages/cost/prices 캐시를 그대로 쓴다
# GCP_BILLING_API_KEY=

# ---- AI 에이전트 (명세 초안·장애 점검). 작업 Z90: 기본 = 실제 Claude API ----
# 키가 없으면 실행이 LLM_KEY_MISSING 으로 실패하고 화면에 "AI 키 없음" 이 뜬다 (가짜 결과를 만들지 않는다)
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5   # claude-opus-5-5 로 바꿀 수 있다
# AGENT_LLM_EFFORT=medium         # low | medium | high | xhigh | max
# AGENT_LLM_TIMEOUT_MS=120000     # 호출 한 번 시간 제한
# AGENT_LLM_MAX_RETRIES=2         # 429·5xx·연결 오류 재시도 횟수
# AGENT_LLM_CACHE=1               # z75-59: 실제 API 응답 캐시 (회사별, 같은 요청이면 다시 안 부름). 0 이면 끔
# AGENT_LLM_CACHE_TTL_SEC=86400   # 캐시 기한 (60~604800). 데모 초기화는 캐시를 안 지운다
# LLM_BUDGET_USD=2                # z75-64: 회사·회차마다 실제 LLM 지출 상한 (달러 추정). 넘으면 새 AI 점검 409·실패 LLM_BUDGET_EXCEEDED. 캐시 응답은 0원
# LLM_BUDGET_GLOBAL_USD=10        # 회차 하나의 모든 회사 합 상한 (API 키가 하나라서). 넘으면 모든 회사가 막힘
# LLM_BUDGET_ROUND=               # 회차 이름 (비우면 오늘 날짜 UTC). 새 회차를 열려면 이름을 바꾼다. 데모 초기화는 지출을 안 지운다
# FAKE_LLM=1                      # 시험 전용 가짜 LLM. 데모·운영에서는 쓰지 않는다 (사전점검이 실패로 본다)
# SANDBOX_MODE=memory             # memory | k3d (맥: k3d cluster agent-sbx + kubectl proxy)
# SANDBOX_KUBE_URL=http://127.0.0.1:8001
# SANDBOX_NODE_PREFIX=k3d-agent-sbx-

# ---- GitOps 배포 (N2). 둘 다 비우면 deploy 는 STUB ----
# GITOPS_REPO_URL=https://github.com/<org>/<gitops-repo>.git
# GITOPS_WRITE_TOKEN=
# GITOPS_READ_TOKEN=
# GITOPS_REPO_DIR=
# GITOPS_BRANCH=main
# push 는 기본 꺼짐. 1 일 때만 원격에 올린다
# GITOPS_PUSH=1
# 설정이 있어도 deploy 를 STUB 으로 (test:db 는 자동으로 켬)
# GITOPS_DISABLE=1

# ---- 트래픽 전환 (J). 토큰이 없으면 STUB 지표·스위치 ----
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_NAME=softbank-team-iron.com
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_SOURCE_POOL_ID=
# CLOUDFLARE_TARGET_POOL_ID=
# TRAFFIC_PROVIDER=
# TRAFFIC_LB_ID=
# TRAFFIC_STUB_SCENARIO=ok
# 단계마다 최소로 관찰할 초 (z75-38: 10%·50%·100% 모두. 100% 는 T22). 운영 기본 30. 로컬 개발·smoke·데모는 짧게 (감사에 observeCompressed 가 남는다)
# 다음 단계로 가려면 이 시간이 지나고 + 실측 도착 몫(지표 창 요청 수)이 목표 ±10%p 안이어야 한다. 못 미치면 같은 길이로 2번 더 보고, 그래도면 paused (TRAFFIC_SHARE_NOT_REACHED)
# TRAFFIC_SHARE_CHECK=0 이면 이 확인을 끈다 (예전 동작: 10%·50% 는 판정 3번, 표본이 없는 실클라우드 리허설 등). 기본 켬
# TRAFFIC_SHARE_CHECK=1
TRAFFIC_OBSERVE_SEC=0.5
# PERMISSIONS_DIR=infra/permissions
# TEMP_ROLE_SWEEP_MS=15000

# ---- 도착 자원 (Z89): 기본 = 진짜 terraform (aws/gcp/onprem). 흉내는 시험 전용 ----
# MOCK_IAC=1 이면 apply 를 흉내(가짜 출력). test:db·e2e·prod-e2e 만 붙인다. .env 에는 넣지 않는다
# MOCK_ARGO=1 이면 GitOps 설정 없을 때 deploy 흉내 (없으면 paused GITOPS_NOT_CONFIGURED)
# 작업 폴더 = TF_WORK_DIR/<회사 slug>/<이전 id> (state 회사별). 예전 USE_TERRAFORM·TF_REAL_APPLY 는 무시
# TF_WORK_DIR=~/.svc-tf
# TF_BIN=terraform
# TF_APPLY_TIMEOUT_SEC=2700
# TF_LOCK_TIMEOUT_SEC=60
# TF_DESTROY_ON_FAIL=1

# ---- Azure 는 Mock 만 (X) ----
AZURE_MOCK=1
# AZURE_MOCK_LATENCY_MS=300
# AZURE_MOCK_FAIL=

# ---- 시험·데모용 실패 흉내 (평소엔 비움) ----
# APPLY_STUB_FAIL=1
# SYNC_STUB_FAIL=1
# REPL_TABLES=customers,orders

# 롤백 가능 창(초). 데모·e2e 롤백 장면에서 버튼 누를 시간. 비우면 3초
# ROLLBACK_WINDOW_SEC=20

# 환경 잠금 기한(초)과 DB에 못 닿을 때 스스로 멈추는 시간(초). 비우면 90·60.
# 워커가 죽었을 때 회복을 빨리 보려면 45·30. 워커·API 모두 같은 값이어야 한다.
# 연장 간격 < 스스로 멈춤 < 기한 이 아니면 시작할 때 멈춘다. 연장 간격은 비우면 기한의 1/3
# ENVLOCK_WORKER_SEC=45
# ENVLOCK_SELF_FENCE_SEC=30
# ENVLOCK_HEARTBEAT_SEC=15

# --- Z92: 온프레 Agent 보고 (POST /api/v1/agent/reports) ---
# 서버(API): Agent 키 비밀을 만드는 마스터 값. 32자 이상. 비우면 보고 경로가 503 AGENT_REPORTS_DISABLED
#   만들기 예: openssl rand -hex 32   (값은 .env 에만, 채팅·공유 폴더 금지)
# AGENT_REPORT_MASTER_KEY=
# heartbeat 가 이 초보다 오래되면 화면에 stale (기본 120)
# AGENT_STALE_SEC=120
# Agent(온프레 쪽, tools/onprem-agent.ts): npm run agent:key 가 .agent-key.env 파일로 써 준다
# AGENT_REPORT_URL=http://localhost:3000
# AGENT_KEY_ID=
# AGENT_KEY_SECRET=
# AGENT_NAMESPACE=app
# AGENT_CNPG_CLUSTER=app-db
# AGENT_KUBE_CONTEXT=k3d-onprem

# --- Z94 Argo CD 반영 확인 (deploy → syncing). 하나도 없으면 클라우드 배포는 ARGO_NOT_CONFIGURED 로 paused ---
# REST 길: 읽기 전용 계정 토큰
# ARGOCD_URL=https://argocd.example.com
# ARGOCD_TOKEN=
# k8s 길: 허브 클러스터 kube 컨텍스트로 Application CR 읽기 (ARGOCD_URL 없을 때)
# ARGO_KUBE_CONTEXT=
# ARGOCD_NAMESPACE=argocd
# ARGO_SOURCE=auto
# ARGO_WAIT_SEC=180
# ARGO_TICK_MS=2000
# ARGO_MAX_ERRORS=10
# ARGO_REQ_TIMEOUT_MS=5000
# MOCK_ARGO=1 은 시험 전용 (바로 ok)

# ── 사전 점검 실조회 (Z97) ── 읽기 명령만(aws sts/ec2/rds/service-quotas, gcloud auth/services/billing/compute/sql, kubectl auth/get)
# MOCK_PRECHECK=1 은 시험 전용(test:db·e2e 가 켬). 데모·리허설에서는 켜지 않는다
# MOCK_PRECHECK=
# PRECHECK_TIMEOUT_MS=10000
# PRECHECK_TCP_TIMEOUT_MS=3000
# GCP_REGION=asia-northeast3
# DB_STORAGE_GB=20
# CLOUDSQL_PG_MAJORS=9.6,10,11,12,13,14,15,16,17

# 신뢰도 문턱값 (0 = 꺼짐, 0~1). 켜면 이 값 미만이고 사람이 승인 안 한 명세 칸이 있을 때 spec_review → prechecking 이 막힌다
SPEC_MIN_CONFIDENCE=0
# API 프로세스에도 청소 담당(lease-reaper) 한 벌. 1이면 켬 (기본 off, 개발 실행용)
API_REAPER=0
# L4: 1 = 진짜 AWS STS(aws sts assume-role CLI). external_id 있는 환경만 진짜, 없는 환경(시드)은 그대로 mock. 비우면 전부 mock
REAL_STS=

# ---- 고객 환경 연결 (입력층 L2). 둘 다 비우면 AWS 연결 링크 발급이 503 CONNECT_NOT_CONFIGURED ----
# CloudFormation 템플릿 S3 https 주소 (infra/onboarding 템플릿을 올린 곳). 가짜 값 넣지 말 것 (진짜 경로로 오해)
CONNECT_TEMPLATE_URL=
# 고객 역할을 빌릴 플랫폼 워커 역할 ARN (arn:aws:iam::<12자리>:role/<이름>). 값은 .env 에만
PLATFORM_PRINCIPAL_ARN=

# 이미지 빌드(명세 v2의 image.source=build 서비스). 1이면 apply 앞에서 부른다. 기본 off (STUB)
# IMAGE_BUILD=0
# L4b: 연결 주기 재확인 일정 (cron 5칸). 비우면 1시간마다 정각. 데모는 "* * * * *", 끄기는 off
VERIFY_CRON=

# 계획 승인 확인 항목 게이트 (PA4). 1 이면 승인 때 acks 가 계획서 확인 항목을 전부 덮어야 하고, /start 본문 planHash 가 승인 지문과 같아야 함. 기본 off
# PLAN_ACKS=0
# 회사당 동시 진행 이전 상한. 넘으면 start 가 409 TENANT_BUSY. 비우거나 0 = 꺼짐
# TENANT_MAX_ACTIVE=0
# L7i: REAL_STS=1 일 때 GCP 진짜 발급(gcloud impersonate)에 쓰는 플랫폼 프로젝트 ID. 비우면 GCP 는 mock
GCP_PLATFORM_PROJECT=
