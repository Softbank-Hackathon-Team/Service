{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "source": {
        "type": "string"
      },
      "confidence": {
        "anyOf": [
          {
            "type": "number",
            "const": 1
          },
          {
            "type": "number",
            "const": 0.9
          },
          {
            "type": "number",
            "const": 0.6
          }
        ]
      },
      "needs_review": {
        "type": "boolean"
      },
      "rationale": {
        "type": "string"
      }
    },
    "required": [
      "source",
      "confidence",
      "needs_review"
    ],
    "additionalProperties": false
  }
}