{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "block",
        "warn",
        "info"
      ]
    },
    "message": {
      "type": "string"
    },
    "fix": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "level",
    "message"
  ],
  "additionalProperties": false
}