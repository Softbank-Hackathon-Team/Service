{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "reject"
      ]
    },
    "planHash": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "decision",
    "planHash"
  ],
  "additionalProperties": false
}