{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "proposed",
        "no_change",
        "gave_up"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 80
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "checked": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notDone": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "outcome",
    "title",
    "reason",
    "checked",
    "notDone"
  ],
  "additionalProperties": false
}