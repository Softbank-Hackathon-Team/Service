{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "app": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,30}$"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "pattern": "@sha256:[a-f0-9]{64}$"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "healthPath": {
              "type": "string",
              "format": "starts_with",
              "pattern": "^\\/.*"
            },
            "replicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "cpu": {
              "type": "string",
              "enum": [
                "1",
                "250m",
                "500m"
              ]
            },
            "memory": {
              "type": "string",
              "enum": [
                "512Mi",
                "1Gi",
                "2Gi"
              ]
            },
            "env": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "required": [
                  "name",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "secretRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "key"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "image",
            "port",
            "healthPath",
            "replicas",
            "cpu",
            "memory",
            "env",
            "secretRefs"
          ],
          "additionalProperties": false
        },
        "database": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "const": "postgres"
            },
            "majorVersion": {
              "type": "string",
              "enum": [
                "15",
                "16",
                "17"
              ]
            },
            "storageGb": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 100
            }
          },
          "required": [
            "engine",
            "majorVersion",
            "storageGb"
          ],
          "additionalProperties": false
        },
        "ingress": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string"
            },
            "entry": {
              "type": "string",
              "const": "cloudflare-lb"
            }
          },
          "required": [
            "hostname",
            "entry"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fieldMeta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 0.9
              },
              {
                "type": "number",
                "const": 0.6
              }
            ]
          },
          "needs_review": {
            "type": "boolean"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "confidence",
          "needs_review"
        ],
        "additionalProperties": false
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "resource",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "spec",
    "fieldMeta",
    "unmapped"
  ],
  "additionalProperties": false
}