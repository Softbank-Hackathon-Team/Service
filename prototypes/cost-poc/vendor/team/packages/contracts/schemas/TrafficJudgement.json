{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "migrationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "stepPct": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "samples": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "target5xx": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "targetErrorRatePct": {
      "type": "number"
    },
    "sourceErrorRatePct": {
      "type": "number"
    },
    "targetP95Ms": {
      "type": "number"
    },
    "sourceP95Ms": {
      "type": "number"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "ok",
        "hold",
        "bad",
        "bad_shortcut"
      ]
    },
    "at": {
      "type": "string"
    }
  },
  "required": [
    "migrationId",
    "stepPct",
    "samples",
    "target5xx",
    "targetErrorRatePct",
    "sourceErrorRatePct",
    "targetP95Ms",
    "sourceP95Ms",
    "verdict",
    "at"
  ],
  "additionalProperties": false
}