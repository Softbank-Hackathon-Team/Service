{
  "name": "cost-poc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DRAFT(ai): 비용 알고리즘 POC. 측정으로 얻는 자원 함수와 벤더별 가격 함수를 분리해 합성한다.",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "collect": "tsx src/collect/run.ts",
    "measure": "bash measure/run-measure.sh",
    "run-all": "tsx scripts/run-all.ts",
    "charts": ".venv/bin/python -I scripts/charts.py && .venv/bin/python -I scripts/build-summary.py"
  },
  "dependencies": {
    "@svc/contracts": "file:vendor/team/packages/contracts",
    "@svc/cost": "file:vendor/team/packages/cost",
    "yaml": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
