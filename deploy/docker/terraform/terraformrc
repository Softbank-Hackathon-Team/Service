# worker 의 terraform CLI 설정 (deploy/docker/Dockerfile worker 단계 ENV TF_CLI_CONFIG_FILE, #373 B1)
# provider 는 이미지에 구운 미러(/opt/terraform/providers)에서 먼저 찾고, 미러에 없는 provider·판만 레지스트리에서 받는다 (direct)
#   미러는 읽기만 한다. 작업 폴더 .terraform/providers 에는 미러로 가는 심볼릭 링크만 생긴다 → 읽기 전용 뿌리·비루트 사용자에서도 된다
#   direct 가 같이 있으면 terraform 은 판 목록을 레지스트리에도 묻는다 (작은 JSON). 그래서 네트워크가 아예 없으면 init 이 실패한다 (예전과 같음)
#   DRAFT(ai): plugin_cache_dir(TF_PLUGIN_CACHE_DIR) 대신 filesystem_mirror. 캐시는 없는 판을 그 폴더에 써 넣어야 해서 읽기 전용 이미지에선 못 쓰고,
#     잠금 파일이 없으면 plugin_cache_may_break_dependency_lock_file 까지 켜야 한다
provider_installation {
  filesystem_mirror {
    path = "/opt/terraform/providers"
  }
  direct {}
}
