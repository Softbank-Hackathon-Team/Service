# @svc/web 정적 화면 + /api 프록시 (Vite 개발 서버 프록시와 같은 규칙)
#   /api/healthz, /api/readyz → ${API_UPSTREAM}/healthz, /readyz
#   /api/그 밖               → ${API_UPSTREAM}${API_PREFIX}/그 밖
# ${...} 는 컨테이너 시작 때 nginx 이미지가 환경변수로 채운다(/etc/nginx/templates)
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }

  location = /api/healthz { proxy_pass ${API_UPSTREAM}/healthz; }
  location = /api/readyz  { proxy_pass ${API_UPSTREAM}/readyz; }
  location /api/ {
    proxy_pass ${API_UPSTREAM}${API_PREFIX}/;
    proxy_set_header Host $host;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 60s;
  }

  # 해시가 붙은 묶음 파일은 오래 캐시, index.html 은 매번 새로
  location /assets/ { expires 7d; add_header Cache-Control "public, immutable"; }
  location / {
    try_files $uri /index.html;
    add_header Cache-Control "no-cache";
  }
}
