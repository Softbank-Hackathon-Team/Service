{
  "app": {
    "name": "shop-api"
  },
  "image": {
    "ref": "<env:registryHost>/platform/t1/shop-api@sha256:abababababababababababababababababababababababababababababababab"
  },
  "replicas": 2,
  "resources": {
    "requests": {
      "cpu": "500m",
      "memory": "1Gi"
    },
    "limits": {
      "memory": "1Gi"
    }
  },
  "port": 8080,
  "probes": {
    "readiness": "/healthz",
    "liveness": "/healthz"
  },
  "env": [
    {
      "name": "LOG_LEVEL",
      "value": "info"
    }
  ],
  "serviceAccount": {
    "name": "shop-api",
    "annotations": {}
  },
  "externalSecrets": {
    "store": {
      "kind": "ClusterSecretStore",
      "name": "vault"
    },
    "refs": [
      {
        "name": "DATABASE_PASSWORD",
        "key": "password"
      }
    ]
  },
  "database": {
    "mode": "cnpg",
    "instances": 1,
    "majorVersion": "16",
    "storageGb": 20,
    "host": "shop-api-db-rw",
    "port": 5432,
    "name": "shop-api",
    "passwordSecret": "shop-api-db-app"
  },
  "ingress": {
    "mode": "cloudflared",
    "className": "",
    "hostname": "shop.example.com",
    "tunnelTokenSecret": "cloudflared-token"
  },
  "labels": {
    "managed-by": "platform",
    "tenant": "t1"
  }
}
