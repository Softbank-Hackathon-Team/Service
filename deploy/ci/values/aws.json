{
  "app": {
    "name": "shop-api"
  },
  "image": {
    "ref": "<env:accountId>.dkr.ecr.ap-northeast-2.amazonaws.com/platform/t1/shop-api@sha256:abababababababababababababababababababababababababababababababab"
  },
  "replicas": 2,
  "resources": {
    "requests": {
      "cpu": "500m",
      "memory": "1Gi"
    },
    "limits": {
      "memory": "1Gi"
    }
  },
  "port": 8080,
  "probes": {
    "readiness": "/healthz",
    "liveness": "/healthz"
  },
  "env": [
    {
      "name": "LOG_LEVEL",
      "value": "info"
    }
  ],
  "serviceAccount": {
    "name": "shop-api",
    "annotations": {}
  },
  "externalSecrets": {
    "store": {
      "kind": "ClusterSecretStore",
      "name": "aws-secrets-manager"
    },
    "refs": [
      {
        "name": "DATABASE_PASSWORD",
        "key": "password"
      }
    ]
  },
  "database": {
    "mode": "external",
    "host": "<tf-output:db_address>",
    "port": 5432,
    "name": "shop-api",
    "passwordSecret": "<tf-output:db_master_secret_arn>",
    "passwordProperty": "password"
  },
  "ingress": {
    "mode": "cloudflared",
    "className": "alb",
    "hostname": "shop.example.com",
    "tunnelTokenSecret": "cloudflared-token"
  },
  "labels": {
    "managed-by": "platform",
    "tenant": "t1"
  }
}
